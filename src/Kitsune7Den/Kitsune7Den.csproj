<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <AssemblyName>Kitsune7Den</AssemblyName>
    <RootNamespace>Kitsune7Den</RootNamespace>
    <Version>1.1.1</Version>
    <!-- Only ship the UI languages we translate; keeps package satellites out of the exe -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <!-- 7D2D 3.x Sandbox option tables (generated by PackRelay's extract-sandbox-options; never hand-edit) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Sandbox\sandbox-3.0.json" LogicalName="Kitsune7Den.Sandbox.3.0.json" />
    <EmbeddedResource Include="Resources\Sandbox\sandbox-3.1.json" LogicalName="Kitsune7Den.Sandbox.3.1.json" />
    <EmbeddedResource Include="Resources\Sandbox\sandbox-3.2.json" LogicalName="Kitsune7Den.Sandbox.3.2.json" />
    <EmbeddedResource Include="Resources\Sandbox\sandbox-3.3.json" LogicalName="Kitsune7Den.Sandbox.3.3.json" />
    <!-- WithCulture=false: otherwise MSBuild reads ".zh-Hans" as a culture and moves it into the satellite assembly -->
    <EmbeddedResource Include="Resources\Sandbox\sandbox.zh-Hans.json" LogicalName="Kitsune7Den.Sandbox.zh-Hans.json" WithCulture="false" />
  </ItemGroup>

</Project>
