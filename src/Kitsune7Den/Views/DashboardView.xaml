<UserControl x:Class="Kitsune7Den.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Kitsune7Den.Converters"
             xmlns:l="clr-namespace:Kitsune7Den.Localization">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusColor" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="700">

            <!-- Welcome / First-run card — only shown when no server is configured -->
            <Border Background="{DynamicResource BgMediumBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    Margin="0,0,0,16" Padding="0"
                    Visibility="{Binding IsFirstRun, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8"
                            Background="{DynamicResource AccentBrush}" />
                    <StackPanel Margin="20,16,20,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{l:Tr Dash_WelcomeTitle}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   Margin="0,0,0,10">
                            <Run Text="{l:Tr Dash_WelcomeIntro}" />
                        </TextBlock>
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4">
                                <Run Text="• " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                <Run Text="{l:Tr Dash_FirstRun_Installed}" FontWeight="SemiBold" />
                                <Run Text="{l:Tr Dash_FirstRun_Click}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{l:Tr Common_Browse}" FontWeight="SemiBold" />
                                <Run Text="{l:Tr Dash_FirstRun_PointTo}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="7DaysToDieServer.exe" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                <Run Text="• " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                <Run Text="{l:Tr Dash_FirstRun_Fresh}" FontWeight="SemiBold" />
                                <Run Text="{l:Tr Dash_FirstRun_HeadTo}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{l:Tr Dash_FirstRun_SettingsSteamCmd}" FontWeight="SemiBold" />
                                <Run Text="{l:Tr Dash_FirstRun_WillInstall}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Server Path Config -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_ServerLocation}" />
                    <TextBlock Text="{l:Tr Dash_ServerLocationHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr Common_Browse}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseExeCommand}" Margin="8,0,0,0" />
                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ServerExePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 ToolTip="{l:Tr Dash_ServerPathTooltip}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_ServerStatus}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- State -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center" Margin="0,0,0,6"
                                     Fill="{Binding ServerState, Converter={StaticResource StatusColor}}" />
                            <TextBlock Text="{Binding ServerStateText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:Tr Dash_State}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Uptime -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="{l:Tr Dash_Uptime}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Players -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayerCount}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <TextBlock Text="{l:Tr Dash_Players}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Controls -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_Controls}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{l:Tr Dash_Start}" Style="{StaticResource ActionButton}"
                                Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}"
                                MinWidth="120" Margin="0,0,8,0" />
                        <Button Content="{l:Tr Dash_Stop}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}"
                                MinWidth="120" Margin="0,0,8,0" />
                        <Button Content="{l:Tr Dash_ConnectTelnet}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ConnectTelnetCommand}"
                                MinWidth="130" Margin="0,0,8,0"
                                ToolTip="{l:Tr Dash_ConnectTelnetTooltip}" />
                        <Button Content="{l:Tr Dash_Restart}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RestartCommand}" IsEnabled="{Binding CanStop}"
                                MinWidth="120" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Automatic Restarts (issue #4) -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsConfigured, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Restart_Header}" />

                    <!-- Status + actions -->
                    <Border Background="#FF0d0d1a" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{l:Tr Restart_CancelCountdown}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CancelRestartCommand}" Padding="10,4" FontSize="12"
                                        Visibility="{Binding RestartCountdownActive, Converter={StaticResource BoolVis}}" />
                                <Button Content="{l:Tr Restart_NowWithWarnings}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RestartWithWarningsCommand}" Padding="10,4" FontSize="12"
                                        IsEnabled="{Binding CanStop}" ToolTip="{l:Tr Restart_NowWithWarningsTooltip}"
                                        Visibility="{Binding RestartCountdownActive, Converter={StaticResource InverseBoolVis}}" />
                            </StackPanel>
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="16" DockPanel.Dock="Left"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding RestartStatusText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <!-- Crash restart -->
                    <CheckBox Content="{l:Tr Restart_CrashEnabled}" IsChecked="{Binding CrashRestartEnabled}"
                              Foreground="{DynamicResource TextPrimaryBrush}" VerticalContentAlignment="Center" />
                    <TextBlock Text="{l:Tr Restart_CrashHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="20,2,0,14" />

                    <!-- Scheduled restart -->
                    <CheckBox Content="{l:Tr Restart_ScheduledEnabled}" IsChecked="{Binding ScheduledRestartEnabled}"
                              Foreground="{DynamicResource TextPrimaryBrush}" VerticalContentAlignment="Center" />
                    <StackPanel Margin="20,8,0,0" IsEnabled="{Binding ScheduledRestartEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <RadioButton Grid.Row="0" Grid.Column="0" GroupName="RestartMode" IsChecked="{Binding IsDailyMode}"
                                         Content="{l:Tr Restart_ModeDaily}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center" Margin="0,0,12,6" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox Style="{StaticResource DarkTextBox}" Width="160"
                                         Text="{Binding RestartTimes, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsDailyMode}" />
                                <TextBlock Text="{l:Tr Restart_TimesHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <RadioButton Grid.Row="1" Grid.Column="0" GroupName="RestartMode"
                                         IsChecked="{Binding IsDailyMode, Converter={StaticResource InverseBool}}"
                                         Content="{l:Tr Restart_ModeInterval}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding RestartIntervalOptions}" SelectedItem="{Binding RestartIntervalHours}"
                                          Width="80" IsEnabled="{Binding IsDailyMode, Converter={StaticResource InverseBool}}" />
                                <TextBlock Text="{l:Tr Restart_HoursOfUptime}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{l:Tr Restart_WarningsHeader}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,4,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Style="{StaticResource DarkTextBox}" Width="160"
                                     Text="{Binding RestartWarningMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{l:Tr Restart_WarningsHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock Text="{l:Tr Restart_MessageHeader}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,4,0,3" />
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="WarningMessageBox" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding RestartWarningMessage, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding DefaultWarningMessage}" IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Text.IsEmpty, ElementName=WarningMessageBox, Converter={StaticResource BoolVis}}" />
                        </Grid>

                        <TextBlock Text="{l:Tr Restart_FinalMessageHeader}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,4,0,3" />
                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="FinalMessageBox" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding RestartFinalMessage, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding DefaultFinalMessage}" IsHitTestVisible="False" Margin="10,0,0,0"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Text.IsEmpty, ElementName=FinalMessageBox, Converter={StaticResource BoolVis}}" />
                        </Grid>
                        <TextBlock Text="{l:Tr Restart_ScheduledHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Save -->
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="{l:Tr Restart_Save}" Style="{StaticResource ActionButton}"
                                Command="{Binding SaveRestartSettingsCommand}" IsEnabled="{Binding RestartSettingsDirty}"
                                Padding="14,5" FontSize="12" />
                        <TextBlock Text="{Binding RestartSettingsError}" Foreground="{DynamicResource AccentBrush}"
                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Connection Info -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:Tr Dash_ConnectionInfo}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LAN -->
                        <Border Grid.Column="0" Background="#FF0d0d1a" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CopyLanCommand}" Padding="8,4" FontSize="11"
                                        ToolTip="{l:Tr Dash_CopyLanTooltip}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Tr Dash_Lan}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontFamily="Consolas">
                                        <Run Text="{Binding LanIp, Mode=OneWay}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding ServerPort, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Public -->
                        <Border Grid.Column="1" Background="#FF0d0d1a" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding CopyPublicCommand}" Padding="8,4" FontSize="11"
                                        ToolTip="{l:Tr Dash_CopyPublicTooltip}" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Tr Dash_Public}" Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="10" FontWeight="Bold" Margin="0,0,0,2" />
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontFamily="Consolas">
                                        <Run Text="{Binding PublicIp, Mode=OneWay}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding ServerPort, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
