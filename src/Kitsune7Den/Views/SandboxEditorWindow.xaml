<Window x:Class="Kitsune7Den.Views.SandboxEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Kitsune7Den.Localization"
        xmlns:vm="clr-namespace:Kitsune7Den.ViewModels"
        Title="{l:Tr Sandbox_WindowTitle}" Width="940" Height="680" MinWidth="720" MinHeight="480"
        Background="{DynamicResource BgDarkBrush}" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Resources/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: table version, presets, search -->
        <Border Grid.Row="0" Background="{DynamicResource BgMediumBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock Text="{Binding TableNote}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TableIsUncertain}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l:Tr Sandbox_Preset}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SandboxPresetViewModel}">
                                <StackPanel Margin="0,2" ToolTip="{Binding Description}">
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Group, Mode=OneWay}" FontSize="10"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="{Binding MatchingPresetText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="12,0" />
                    <Grid Grid.Column="3">
                        <TextBox x:Name="SearchBox" Style="{StaticResource DarkTextBox}"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="{l:Tr Sandbox_Search}" IsHitTestVisible="False" Margin="10,0,0,0"
                                   VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Body: category list + options -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     Background="{DynamicResource BgMediumBrush}" BorderThickness="0,0,1,0"
                     BorderBrush="{DynamicResource BorderBrush}" Padding="0,8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="18,9" Cursor="Hand">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgLightBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgLightBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SandboxCategoryViewModel}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" MinWidth="18"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding ChangedCount, Converter={StaticResource CountVis}}">
                                <TextBlock Text="{Binding ChangedCount}" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,12,20,12">
                <ItemsControl ItemsSource="{Binding SelectedCategory.VisibleOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SandboxOptionViewModel}">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        <TextBlock FontSize="10" Opacity="0.6" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DefaultLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center"
                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                                              DisplayMemberPath="Label" />
                                    <Button Grid.Column="2" Content="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                            ToolTip="{l:Tr Sandbox_ResetOption}" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand" Padding="4"
                                            Command="{Binding DataContext.ResetOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsChanged, Converter={StaticResource BoolVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Footer: the code itself + actions -->
        <Border Grid.Row="2" Background="{DynamicResource BgMediumBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                    <Button Content="{l:Tr Sandbox_ResetAll}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetAllCommand}" Margin="0,0,8,0" />
                    <Button Content="{l:Tr Common_Cancel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="{l:Tr Sandbox_Apply}" Style="{StaticResource ActionButton}"
                            Command="{Binding ApplyCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4">
                        <Run Text="{l:Tr Sandbox_CodeLabel}" /><Run Text="  " /><Run Text="{Binding ChangedCount, Mode=OneWay}"
                             Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text=" " /><Run Text="{l:Tr Sandbox_ChangedSuffix}" />
                    </TextBlock>
                    <TextBox Style="{StaticResource DarkTextBox}" FontFamily="Consolas" FontSize="12"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                    <TextBlock Text="{Binding CodeProblem}" Foreground="{DynamicResource WarningBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding CodeProblem, Converter={StaticResource StringVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
